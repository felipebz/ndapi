{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergePatch",
    "schedule:weekly"
  ],
  "mode": "full",
  "packageRules": [
    {
      "matchFileNames": [
        "global.json"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "enabled": false
    },
    {
      "description": "The Roslyn version is the oldest compiler that can load the generator, so it's raised by hand",
      "matchPackageNames": [
        "Microsoft.CodeAnalysis.Analyzers",
        "Microsoft.CodeAnalysis.CSharp"
      ],
      "enabled": false
    }
  ]
}
