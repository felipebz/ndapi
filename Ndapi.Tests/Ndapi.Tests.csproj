<Project Sdk="Microsoft.NET.Sdk">

    <!--
    Integration tests: they call the Oracle Forms Open API, so they need a local Forms installation.
    TestRuntime picks the Forms flavour: win-x86 for Forms 6i (32-bit only, the default on Windows) or
    linux-x64 / win-x64 for Forms 12c/14c (linux-x64 is the default elsewhere).
    Override with: dotnet build Ndapi.Tests -p:TestRuntime=win-x86
    PlatformTarget is inferred from the RuntimeIdentifier.
    -->
    <PropertyGroup>
        <TestRuntime Condition="'$(TestRuntime)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x86</TestRuntime>
        <TestRuntime Condition="'$(TestRuntime)' == ''">linux-x64</TestRuntime>
    </PropertyGroup>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RuntimeIdentifier>$(TestRuntime)</RuntimeIdentifier>
        <SelfContained>false</SelfContained>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <!-- runs on Microsoft.Testing.Platform (see global.json): use dotnet test, or dotnet run on this project -->
    <ItemGroup>
        <PackageReference Include="xunit.v3"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="Coverage\*.txt" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Ndapi\Ndapi.csproj"/>
    </ItemGroup>

</Project>
