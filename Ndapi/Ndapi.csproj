<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <Description>Read, create, modify and compile Oracle Forms modules (.fmb, .mmb, .olb, .pll) from .NET through the Oracle Forms Open API. Supports Forms 6i, 12c and 14c.</Description>
        <Authors>Felipe Zorzo</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/felipebz/ndapi</PackageProjectUrl>
        <RepositoryUrl>https://github.com/felipebz/ndapi</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>oracle wrapper API oracleforms</PackageTags>
        <!-- updated by release-please; CI builds between releases get a prerelease suffix -->
        <VersionPrefix>13.1.0</VersionPrefix>
        <PackageReleaseNotes>https://github.com/felipebz/ndapi/blob/main/CHANGELOG.md</PackageReleaseNotes>
        <NoWarn>NU5128</NoWarn>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsAotCompatible>true</IsAotCompatible>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\NdapiSourceGenerator\NdapiSourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="DotNet.ReproducibleBuilds" Version="2.0.5" PrivateAssets="All"/>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100" PrivateAssets="All"/>
    </ItemGroup>

</Project>
