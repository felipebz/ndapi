<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
        <Description>Read, create, modify and compile Oracle Forms modules (.fmb, .mmb, .olb, .pll) from .NET through the Oracle Forms Open API. Supports Forms 6i, 12c and 14c.</Description>
        <Authors>Felipe Zorzo</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/felipebz/ndapi</PackageProjectUrl>
        <!-- explicit: SourceLink would otherwise take it from the clone's remote -->
        <RepositoryUrl>https://github.com/felipebz/ndapi</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>oracle wrapper API oracleforms</PackageTags>
        <!-- updated by release-please; CI builds between releases get a prerelease suffix -->
        <VersionPrefix>14.1.1</VersionPrefix>
        <PackageReleaseNotes>https://github.com/felipebz/ndapi/blob/main/CHANGELOG.md</PackageReleaseNotes>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- CS1591: undocumented public members (mostly enum members), documented over time -->
        <NoWarn>CS1591</NoWarn>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <!--
    CI packs prerelease builds (-p:Version=X.Y.Z-alpha.N) and compares their API with the last release, which is
    VersionPrefix between releases. Version is only set here when it comes from the command line (the SDK derives it
    from VersionPrefix later), so restore, format, build and the release pack never download a baseline.
    Intentional breaking changes are listed in CompatibilitySuppressions.xml:
    regenerate it with a version above the baseline, e.g.
    dotnet pack -p:Version=14.0.1-ci -p:GenerateCompatibilitySuppressionFile=true
    -->
    <PropertyGroup Condition="'$(Version)' != '' and '$(Version)' != '$(VersionPrefix)'">
        <EnablePackageValidation>true</EnablePackageValidation>
        <PackageValidationBaselineVersion>$(VersionPrefix)</PackageValidationBaselineVersion>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Ndapi.UnitTests"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\NdapiSourceGenerator\NdapiSourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="DotNet.ReproducibleBuilds" PrivateAssets="All"/>
    </ItemGroup>

</Project>
