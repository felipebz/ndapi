<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <Description>Read, create, modify and compile Oracle Forms modules (.fmb, .mmb, .olb, .pll) from .NET through the Oracle Forms Open API. Supports Forms 6i, 12c and 14c.</Description>
        <Authors>Felipe Zorzo</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/felipebz/ndapi</PackageProjectUrl>
        <RepositoryUrl>https://github.com/felipebz/ndapi</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>oracle wrapper API oracleforms</PackageTags>
        <!-- updated by release-please; CI builds between releases get a prerelease suffix -->
        <VersionPrefix>13.1.0</VersionPrefix>
        <PackageReleaseNotes>https://github.com/felipebz/ndapi/blob/main/CHANGELOG.md</PackageReleaseNotes>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- CS1591: undocumented public members (mostly enum members), documented over time -->
        <NoWarn>NU5128;CS1591</NoWarn>
        <Nullable>enable</Nullable>
        <WarningsAsErrors>nullable</WarningsAsErrors>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsAotCompatible>true</IsAotCompatible>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
    </PropertyGroup>

    <!--
    CI packs prerelease builds (Version != VersionPrefix) and compares their API with the last release, which is
    VersionPrefix between releases. Intentional breaking changes are listed in CompatibilitySuppressions.xml:
    regenerate it with dotnet pack -p:Version=0.0.1-ci -p:GenerateCompatibilitySuppressionFile=true
    -->
    <PropertyGroup Condition="'$(Version)' != '$(VersionPrefix)'">
        <EnablePackageValidation>true</EnablePackageValidation>
        <PackageValidationBaselineVersion>$(VersionPrefix)</PackageValidationBaselineVersion>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\NdapiSourceGenerator\NdapiSourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="DotNet.ReproducibleBuilds" Version="2.0.5" PrivateAssets="All"/>
    </ItemGroup>

</Project>
