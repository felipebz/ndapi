<Project Sdk="Microsoft.NET.Sdk">

    <!--
    The runtime identifier picks the Oracle Forms flavour:
      dotnet run -r win-x86                    Forms 6i (32-bit only)
      dotnet run -r win-x64 / -r linux-x64     Forms 12c/14c
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <PublishAot>true</PublishAot>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Ndapi\Ndapi.csproj"/>
        <!-- trims and compiles the whole library, so publishing also validates Ndapi for NativeAOT -->
        <TrimmerRootAssembly Include="Ndapi"/>
    </ItemGroup>
</Project>
